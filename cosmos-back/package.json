{
  "name": "cosmos-back",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:debug": "node --inspect-brk node_modules/jest/bin/jest.js --config jest.config.ts --runInBand",
    "test:e2e": "jest --config test/jest-integration.config.ts --runInBand",
    "format:inspect": "ts-node -T tools/format-inspector/extract.ts",
    "format:generate": "ts-node -T tools/format-inspector/generate.ts",
    "format:e2e-fixtures": "ts-node -T tools/format-inspector/e2e-fixtures.ts",
    "report:registros": "ts-node -T tools/reports/registros.ts",
    "maintenance:rostros": "ts-node -T tools/maintenance/rostros-duplicados.ts",
    "test:int": "jest --config test/jest-integration.config.ts --runInBand",
    "test:int:cov": "jest --config test/jest-integration.config.ts --runInBand --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:ci": "node tools/lint-ratchet.mjs .",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "qa": "npm run lint:ci && npm run typecheck && npm run test:cov && npm run test:int",
    "lint:baseline": "node tools/lint-ratchet.mjs . --update",
    "lint:report": "eslint . -f stylish",
    "audit:ci": "node tools/audit-gate.mjs .",
    "perf:smoke": "k6 run perf/smoke.js",
    "perf:carga": "k6 run perf/carga.js",
    "hooks": "node tools/install-hooks.mjs",
    "hooks:quitar": "node tools/install-hooks.mjs --desinstalar"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.848.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.2.0",
    "@simplewebauthn/server": "^13.1.2",
    "@simplewebauthn/types": "^12.0.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/multer": "^2.0.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "bwip-js": "^4.7.0",
    "canvas": "^3.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "face-api.js": "^0.22.2",
    "fflate": "^0.8.2",
    "mongoose": "^8.16.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
