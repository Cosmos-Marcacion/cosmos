{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": true,
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../public",
        "outDir": "./public",
        "watchAssets": true
      },
      {
        "include": "modules/format/v2/definitions/generated/*.json",
        "watchAssets": true
      }
    ]
  }
}
