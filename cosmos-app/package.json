{
  "name": "cosmos-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --progress=false",
    "test:watch": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint:ci": "node tools/lint-ratchet.mjs .",
    "lint:baseline": "node tools/lint-ratchet.mjs . --update",
    "qa": "npm run typecheck && npm run test && npm run build",
    "audit:ci": "node tools/audit-gate.mjs .",
    "hooks": "node tools/install-hooks.mjs",
    "hooks:quitar": "node tools/install-hooks.mjs --desinstalar",
    "e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.5",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.2",
    "@simplewebauthn/browser": "^13.1.2",
    "@simplewebauthn/types": "^12.0.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "@zxing/ngx-scanner": "^20.0.0",
    "exceljs": "^4.4.0",
    "face-api.js": "^0.22.2",
    "fingercosmos-plugin": "file:fingercosmos-plugin",
    "install": "^0.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/utils": "^8.70.0",
    "angular-eslint": "^22.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.10.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0"
  }
}
