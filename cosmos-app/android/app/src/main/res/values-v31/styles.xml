<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12 (API 31) en adelante.

      A partir de esta versión el sistema dibuja él mismo la pantalla de
      arranque y deja de usar `android:background` del tema, que es como
      funcionaba el splash hasta ahora. Sin estos atributos Android mostraría
      el icono del lanzador sobre un fondo genérico.

      Se le indica el color corporativo y el isotipo en blanco. Como el fondo
      del icono es transparente, el sistema trata el lienzo como 288dp y solo
      muestra el circulo interior de 192dp, por eso se usa `ic_splash_icon`, que
      trae la marca centrada y con margen, en lugar del icono del lanzador.

      `ic_splash_icon` se genera a 288dp por densidad (288/432/576/864/1152 px).
      Antes reutilizaba los tamaños del icono del lanzador, que son de 108dp, y
      el sistema lo escalaba x2,7: la marca salia borrosa en cualquier movil de
      gama media para arriba.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/cosmosBrand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

        <!-- Fondo de la ventana entre que se cierra el splash del sistema y el
             WebView pinta la primera vista: mismo color, sin parpadeo. -->
        <item name="android:background">@color/cosmosBrand</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/cosmosBrand</item>
        <item name="android:navigationBarColor">@color/cosmosBrand</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>
