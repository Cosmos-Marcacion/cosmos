<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilos para Android API 21+ (Lollipop y superior) -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Configuraciones específicas para el StatusBar en Android 5.0+ -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/cosmosBrand</item>
        <item name="android:navigationBarColor">@color/cosmosBrand</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Configuraciones específicas para el StatusBar en Android 5.0+ -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/cosmosBrand</item>
        <item name="android:navigationBarColor">@color/cosmosBrand</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:background">@drawable/splash</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Configuraciones específicas para el StatusBar en Android 5.0+ -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/cosmosBrand</item>
        <item name="android:navigationBarColor">@color/cosmosBrand</item>
        <!-- Configurar el tema para que no ocupe toda la pantalla -->
        <item name="android:windowFullscreen">false</item>
        <!-- Asegurar que el StatusBar sea visible -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
