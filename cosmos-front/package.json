{
  "name": "cosmos-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --progress=false",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test:watch": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint:ci": "node tools/lint-ratchet.mjs .",
    "lint:baseline": "node tools/lint-ratchet.mjs . --update",
    "e2e:a11y": "playwright test --grep @a11y",
    "e2e:visual": "playwright test --grep @visual",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "qa": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "audit:ci": "node tools/audit-gate.mjs .",
    "hooks": "node tools/install-hooks.mjs",
    "hooks:quitar": "node tools/install-hooks.mjs --desinstalar"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/router": "20.3.34",
    "@types/chart.js": "^4.0.1",
    "@types/file-saver": "^2.0.7",
    "chart.js": "^4.5.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "20.3.34",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^22.5.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0"
  }
}
